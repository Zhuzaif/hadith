:{"hadithnumber_first":2882,"hadithnumber_last":3119,"arabicnumber_first":2882,"arabicnumber_last":3119},"26":{"hadithnumber_first":3120,"hadithnumber_last":3161,"arabicnumber_first":3120,"arabicnumber_last":3161},"27":{"hadithnumber_first":3162,"hadithnumber_last":3199,"arabicnumber_first":3162,"arabicnumber_last":3199},"28":{"hadithnumber_first":3200,"hadithnumber_last":3250,"arabicnumber_first":3200,"arabicnumber_last":3250},"29":{"hadithnumber_first":3251,"hadithnumber_last":3370,"arabicnumber_first":3251,"arabicnumber_last":3370},"30":{"hadithnumber_first":3371,"hadithnumber_last":3435,"arabicnumber_first":3371,"arabicnumber_last":3435},"31":{"hadithnumber_first":3436,"hadithnumber_last":3549,"arabicnumber_first":3436,"arabicnumber_last":3549},"32":{"hadithnumber_first":3550,"hadithnumber_last":3656,"arabicnumber_first":3550,"arabicnumber_last":3656},"33":{"hadithnumber_first":3657,"hadithnumber_last":3826,"arabicnumber_first":3657,"arabicnumber_last":3826},"34":{"hadithnumber_first":3827,"hadithnumber_last":3892,"arabicnumber_first":3827,"arabicnumber_last":3892},"35":{"hadithnumber_first":3893,"hadithnumber_last":3926,"arabicnumber_first":3893,"arabicnumber_last":3926},"36":{"hadithnumber_first":3927,"hadithnumber_last":4099,"arabicnumber_first":3927,"arabicnumber_last":4099},"37":{"hadithnumber_first":4100,"hadithnumber_last":4341,"arabicnumber_first":4100,"arabicnumber_last":4341}}},"hadiths":[{"hadithnumber":2492,"arabicnumber":2492,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: جس کے پاس کھجور کے درخت ہوں یا زمین ہو تو وہ اسے اس وقت تک نہ بیچے، جب تک کہ اسے اپنے شریک پر پیش نہ کر دے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":17,"hadith":1}},{"hadithnumber":2493,"arabicnumber":2493,"text":"عبداللہ بن عباس رضی اللہ عنہما کہتے ہیں کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: جس کے پاس زمین ہو اور وہ اس کو بیچنا چاہے تو اسے چاہیئے کہ وہ اسے اپنے پڑوسی پر پیش کرے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih Lighairihi"},{"name":"Shuaib Al Arnaut","grade":"Sahih Lighairihi"},{"name":"Zubair Ali Zai","grade":"Sahih"}],"reference":{"book":17,"hadith":2}},{"hadithnumber":2494,"arabicnumber":2494,"text":"جابر رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: پڑوسی اپنے پڑوسی کے شفعہ کا زیادہ حقدار ہے، اس کا انتظار کیا جائے گا اگر وہ موجود نہ ہو جب دونوں کا راستہ ایک ہو ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Hasan"},{"name":"Zubair Ali Zai","grade":"Isnaad Hasan"}],"reference":{"book":17,"hadith":3}},{"hadithnumber":2495,"arabicnumber":2495,"text":"ابورافع رضی اللہ عنہ سے روایت ہے کہ نبی اکرم صلی اللہ علیہ وسلم نے فرمایا: پڑوسی اپنے نزدیکی مکان کا زیادہ حقدار ہے ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":17,"hadith":4}},{"hadithnumber":2496,"arabicnumber":2496,"text":"شرید بن سوید رضی اللہ عنہ کہتے ہیں کہ میں نے عرض کیا: اللہ کے رسول! ایک زمین ہے جس میں کسی کا حصہ نہیں اور نہ کوئی شرکت ہے، سوائے پڑوسی کے ( تو اس کے بارے میں فرمائیے؟! ) آپ صلی اللہ علیہ وسلم نے فرمایا: پڑوسی اپنی نزدیکی زمین کا زیادہ حقدار ہے","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Hasan Sahih"},{"name":"Shuaib Al Arnaut","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Isnaad Sahih"}],"reference":{"book":17,"hadith":5}},{"hadithnumber":2497,"arabicnumber":2497,"text":"ابوہریرہ رضی اللہ عنہ سے روایت ہے کہ رسول اللہ صلی اللہ علیہ وسلم نے ایسی جائیداد میں شفعہ کا حکم دیا ہے جو تقسیم نہ کی گئی ہو، لیکن جب تقسیم ہو جائے اور حد بندی ہو تو شفعہ نہیں ہے۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"}],"reference":{"book":17,"hadith":6}},{"hadithnumber":2498,"arabicnumber":2498,"text":"ابورافع رضی اللہ عنہ کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شریک ( ساجھی دار ) اپنی قریبی جائیداد کا زیادہ حقدار ہے، خواہ کوئی بھی چیز ہو ۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":17,"hadith":8}},{"hadithnumber":2499,"arabicnumber":2499,"text":"جابر بن عبداللہ رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے شفعہ ہر اس جائیداد میں ٹھہرایا ہے جو تقسیم نہ کی گئی ہو، اور جب حد بندی ہو جائے اور راستے جدا ہو جائیں تو اب شفعہ نہیں ہے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Sahih"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Sahih"},{"name":"Zubair Ali Zai","grade":"Sahih Bukhari"}],"reference":{"book":17,"hadith":9}},{"hadithnumber":2500,"arabicnumber":2500,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شفعہ اونٹ کی رسی کھولنے کے مانند ہے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Shuaib Al Arnaut","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":17,"hadith":10}},{"hadithnumber":2501,"arabicnumber":2501,"text":"عبداللہ بن عمر رضی اللہ عنہما کہتے ہیں کہ رسول اللہ صلی اللہ علیہ وسلم نے فرمایا: شریک کو شریک پر اس وقت شفعہ نہیں رہتا ہے، جب وہ خریداری میں اس سے سبقت کر جائے، اسی طرح نہ کم سن ( نابالغ ) کے لیے شفعہ ہے، اور نہ غائب کے لیے ۱؎۔","grades":[{"name":"Al-Albani","grade":"Very Daif"},{"name":"Muhammad Fouad Abd al-Baqi","grade":"Very Daif"},{"name":"Shuaib Al Arnaut","grade":"Very Daif"},{"name":"Zubair Ali Zai","grade":"Daif"}],"reference":{"book":17,"hadith":11}}]}